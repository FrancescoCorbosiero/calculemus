---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/percorsi-url';

/**
 * La gerarchia di Chomsky: le quattro classi di grammatiche come inclusioni
 * concentriche, ognuna col suo automa e un esempio. SVG a rettangoli annidati,
 * tema-consapevole, con alternativa testuale completa.
 */

interface Livello {
  tipo: string;
  nome: string;
  automa: string;
  esempio: string;
  dettaglio: string;
}

/** Dall'esterno all'interno: tipo 0 contiene tutto, tipo 3 è il più piccolo. */
const LIVELLI: Livello[] = [
  {
    tipo: 'Tipo 0',
    nome: 'Ricorsivamente enumerabili',
    automa: 'macchina di Turing',
    esempio: 'tutto ciò che un programma può riconoscere',
    dettaglio:
      'Nessun vincolo sulle regole di produzione. È la classe di tutto ciò che una macchina di Turing può riconoscere — al prezzo che il riconoscimento può non terminare mai: qui abita l’indecidibilità.',
  },
  {
    tipo: 'Tipo 1',
    nome: 'Dipendenti dal contesto',
    automa: 'automa limitato linearmente',
    esempio: 'aⁿbⁿcⁿ — tre blocchi uguali',
    dettaglio:
      'Le regole possono guardare il contesto del simbolo da riscrivere. Bastano a linguaggi come «n copie di a, poi n di b, poi n di c», che il livello inferiore non raggiunge.',
  },
  {
    tipo: 'Tipo 2',
    nome: 'Libere dal contesto',
    automa: 'automa a pila',
    esempio: 'parentesi bilanciate',
    dettaglio:
      'Un solo simbolo a sinistra di ogni regola: la struttura ad albero della sintassi. È il livello dei linguaggi di programmazione (nella sostanza) e dei loro parser: riconoscibili con una pila.',
  },
  {
    tipo: 'Tipo 3',
    nome: 'Regolari',
    automa: 'automa a stati finiti',
    esempio: 'espressioni regolari',
    dettaglio:
      'Il livello più povero e più veloce: memoria finita, nessun conteggio arbitrario. Non sa nemmeno bilanciare le parentesi — ma riconosce le «parole» di un linguaggio, ed è ovunque, dal lessico dei compilatori alla ricerca nel testo.',
  },
];

const LARGH = 640;
const ALT = 460;
const PASSO = 52; // rientro di ogni livello annidato
---

<Base
  titolo="La gerarchia di Chomsky"
  descrizione="Le quattro classi di grammatiche e i loro automi, come inclusioni concentriche con esempi per ciascun livello."
>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="font-serif text-3xl">La gerarchia di Chomsky</h1>
    <p class="mt-2 max-w-2xl text-sm" style="color: var(--testo-tenue)">
      Nel 1956 <a class="underline" href={withBase('/voce/chomsky')}>Chomsky</a> classifica le
      grammatiche per la forma delle loro regole, e la classifica si rivela una scala di macchine:
      a ogni classe di linguaggi corrisponde l’<a class="underline" href={withBase('/voce/automa')}>automa</a> minimo
      che li riconosce, su fino alla
      <a class="underline" href={withBase('/voce/macchina-di-turing')}>macchina di Turing</a>. Le
      inclusioni sono proprie: ogni anello contiene davvero qualcosa in più. La
      <a class="underline" href={withBase('/voce/gerarchia-di-chomsky')}>voce dell’atlante</a> racconta
      la storia; qui la struttura.
    </p>

    <div class="mt-8 rounded-lg border border-bordo bg-rialzato p-4 overflow-x-auto">
      <svg viewBox={`0 0 ${LARGH} ${ALT}`} role="img" aria-labelledby="titolo-svg-gdc" class="w-full min-w-[560px]">
        <title id="titolo-svg-gdc">
          Quattro rettangoli annidati: dall’esterno, linguaggi ricorsivamente enumerabili, dipendenti
          dal contesto, liberi dal contesto, regolari. Descrizione completa sotto il diagramma.
        </title>
        {
          LIVELLI.map((livello, i) => {
            const x = 12 + i * PASSO;
            const y = 12 + i * (PASSO + 12);
            const largh = LARGH - 24 - i * PASSO * 2;
            const alt = ALT - 24 - i * (PASSO + 12) * 2 + (i > 0 ? i * 26 : 0);
            return (
              <g>
                <rect
                  x={x}
                  y={y}
                  width={largh}
                  height={alt}
                  rx="10"
                  fill="var(--sfondo)"
                  fill-opacity={i === 0 ? '1' : '0.0'}
                  stroke={i === 0 ? 'var(--bordo-forte)' : 'var(--accento)'}
                  stroke-opacity={i === 0 ? '1' : String(0.45 + i * 0.18)}
                  stroke-width={i === 0 ? 1.4 : 1.6}
                />
                <text x={x + 14} y={y + 24} font-size="12" font-weight="700" fill="var(--accento)">
                  {livello.tipo}
                </text>
                <text x={x + 60} y={y + 24} font-size="13.5" font-weight="600" fill="var(--testo)">
                  {livello.nome}
                </text>
                <text x={x + 14} y={y + 42} font-size="11" fill="var(--testo-tenue)">
                  automa: {livello.automa} · es.: {livello.esempio}
                </text>
              </g>
            );
          })
        }
        <text x={LARGH - 20} y={ALT - 18} text-anchor="end" font-size="11" fill="var(--testo-tenue)">
          ogni rettangolo contiene per intero il successivo: le inclusioni sono proprie
        </text>
      </svg>
    </div>

    <section class="mt-8" aria-labelledby="alt-gdc">
      <h2 id="alt-gdc" class="font-serif text-xl">Alternativa testuale: i quattro livelli</h2>
      <p class="mt-1 text-sm max-w-2xl" style="color: var(--testo-tenue)">
        Dall’esterno all’interno — dal più potente al più povero. Ogni classe contiene interamente
        le successive.
      </p>
      <ol class="mt-3 space-y-3 text-sm leading-relaxed max-w-2xl list-decimal ps-5">
        {
          LIVELLI.map((livello) => (
            <li>
              <strong>
                {livello.tipo} · {livello.nome}
              </strong>{' '}
              — automa: {livello.automa}; esempio: {livello.esempio}. {livello.dettaglio}
            </li>
          ))
        }
      </ol>
    </section>

    <p class="mt-8 text-sm max-w-2xl leading-relaxed" style="color: var(--testo-tenue)">
      La gerarchia è il ponte fra la linguistica e l’informatica: nata per le lingue naturali, è
      diventata l’ossatura dei <a class="underline" href={withBase('/voce/compilatore')}>compilatori</a> —
      lessico regolare, sintassi libera dal contesto — e la prima mappa della potenza espressiva:
      per dimostrare che un <a class="underline" href={withBase('/voce/linguaggio-di-programmazione')}>linguaggio</a> richiede
      una certa macchina, basta collocarlo sulla scala.
    </p>
  </div>
</Base>
