---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/percorsi-url';

/**
 * La macchina di Turing: nastro, testina, tabella di stati, con un esempio
 * di esecuzione passo per passo (incremento binario: 1011 → 1100).
 * SVG disegnato a mano, tema-consapevole, con alternativa testuale completa.
 */

interface Regola {
  stato: string;
  legge: string;
  scrive: string;
  muove: '→' | '←' | '·';
  prossimo: string;
}

const REGOLE: Regola[] = [
  { stato: 'scorri', legge: '0 o 1', scrive: '(uguale)', muove: '→', prossimo: 'scorri' },
  { stato: 'scorri', legge: '␣', scrive: '␣', muove: '←', prossimo: 'riporto' },
  { stato: 'riporto', legge: '1', scrive: '0', muove: '←', prossimo: 'riporto' },
  { stato: 'riporto', legge: '0', scrive: '1', muove: '·', prossimo: 'fine' },
  { stato: 'riporto', legge: '␣', scrive: '1', muove: '·', prossimo: 'fine' },
];

/** Fotogrammi dell'esecuzione su 1011 (undici) → 1100 (dodici). */
interface Fotogramma {
  nastro: string[];
  testina: number; // indice della cella letta
  stato: string;
  didascalia: string;
}

const FOTOGRAMMI: Fotogramma[] = [
  { nastro: ['1', '0', '1', '1', '␣'], testina: 0, stato: 'scorri', didascalia: 'La testina parte a sinistra nello stato «scorri»: legge 1, lo lascia com’è, si sposta a destra.' },
  { nastro: ['1', '0', '1', '1', '␣'], testina: 3, stato: 'scorri', didascalia: 'Tre passi dopo è sull’ultima cifra: ha solo scorso il numero, senza cambiarlo.' },
  { nastro: ['1', '0', '1', '1', '␣'], testina: 4, stato: 'scorri', didascalia: 'Legge la cella vuota ␣: il numero è finito. Torna indietro e passa allo stato «riporto».' },
  { nastro: ['1', '0', '1', '0', '␣'], testina: 3, stato: 'riporto', didascalia: 'Legge 1: lo scrive 0 e porta il riporto a sinistra (1 + 1 = 10 in binario).' },
  { nastro: ['1', '0', '0', '0', '␣'], testina: 2, stato: 'riporto', didascalia: 'Ancora un 1: ancora 0, il riporto continua a salire.' },
  { nastro: ['1', '1', '0', '0', '␣'], testina: 1, stato: 'fine', didascalia: 'Legge 0: lo scrive 1 e si ferma. Sul nastro c’è 1100: dodici. L’incremento è fatto.' },
];

const CELLA = 44; // lato di una cella del nastro
const X0 = 46; // inizio del nastro nell'SVG
const RIGA = 96; // altezza di un fotogramma
const LARGH = 640;
const ALT = FOTOGRAMMI.length * RIGA + 20;
---

<Base
  titolo="La macchina di Turing"
  descrizione="Nastro, testina, tabella di stati: il modello minimo di calcolatore, con un esempio di esecuzione passo per passo — l'incremento binario."
>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="font-serif text-3xl">La macchina di Turing</h1>
    <p class="mt-2 max-w-2xl text-sm" style="color: var(--testo-tenue)">
      Un nastro infinito di celle, una testina che legge e scrive una cella alla volta, una tabella
      finita di regole: è tutto ciò che serve, mostrò
      <a class="underline" href={withBase('/voce/turing')}>Turing</a> nel 1936, per catturare
      l’idea di calcolo. Qui la <a class="underline" href={withBase('/voce/macchina-di-turing')}>macchina</a> più
      piccola che valga la pena guardare: incrementa di uno un numero binario. Cinque regole,
      nessun trucco — e la stessa struttura di ogni programma che sia mai girato.
    </p>

    <h2 class="mt-8 font-serif text-xl">La tabella di stati</h2>
    <p class="mt-1 text-sm max-w-2xl" style="color: var(--testo-tenue)">
      La macchina è per intero in questa tabella: dato lo stato corrente e il simbolo letto, che
      cosa scrivere, dove muoversi, in che stato passare. Non c’è altro testo da leggere: questo
      <em>è</em> il programma.
    </p>
    <div class="mt-4 overflow-x-auto rounded-lg border border-bordo bg-rialzato">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-bordo text-left">
            <th scope="col" class="px-4 py-2.5 font-semibold">Stato</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">Legge</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">Scrive</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">Muove</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">Passa a</th>
          </tr>
        </thead>
        <tbody>
          {
            REGOLE.map((r) => (
              <tr class="border-b border-bordo last:border-b-0">
                <td class="px-4 py-2 font-mono text-xs">{r.stato}</td>
                <td class="px-4 py-2 font-mono text-xs">{r.legge}</td>
                <td class="px-4 py-2 font-mono text-xs">{r.scrive}</td>
                <td class="px-4 py-2">{r.muove === '·' ? 'si ferma' : r.muove}</td>
                <td class="px-4 py-2 font-mono text-xs">{r.prossimo}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 class="mt-10 font-serif text-xl">L’esecuzione, passo per passo</h2>
    <p class="mt-1 text-sm max-w-2xl" style="color: var(--testo-tenue)">
      Sul nastro c’è 1011 — undici, in binario. Sei fotogrammi dell’esecuzione: la testina
      (in colore d’accento) porta scritto lo stato in cui si trova. La descrizione completa di
      ogni passo è sotto il diagramma.
    </p>

    <div class="mt-4 rounded-lg border border-bordo bg-rialzato p-4 overflow-x-auto">
      <svg
        viewBox={`0 0 ${LARGH} ${ALT}`}
        role="img"
        aria-labelledby="titolo-svg-mdt"
        class="w-full min-w-[560px]"
        style="max-width: 100%"
      >
        <title id="titolo-svg-mdt">
          Sei fotogrammi dell’esecuzione della macchina che incrementa un numero binario: il nastro
          passa da 1011 a 1100. Descrizione testuale completa sotto il diagramma.
        </title>
        {
          FOTOGRAMMI.map((f, i) => {
            const y = i * RIGA + 14;
            return (
              <g>
                <text x="8" y={y + CELLA / 2 + 4} font-size="12" fill="var(--testo-tenue)">
                  {i + 1}.
                </text>
                {f.nastro.map((simbolo, j) => (
                  <g>
                    <rect
                      x={X0 + j * CELLA}
                      y={y}
                      width={CELLA}
                      height={CELLA}
                      fill={j === f.testina ? 'var(--sfondo-incassato)' : 'var(--sfondo)'}
                      stroke="var(--bordo-forte)"
                      stroke-width="1.2"
                    />
                    <text
                      x={X0 + j * CELLA + CELLA / 2}
                      y={y + CELLA / 2 + 5}
                      text-anchor="middle"
                      font-size="17"
                      font-weight="600"
                      fill={simbolo === '␣' ? 'var(--testo-tenue)' : 'var(--testo)'}
                    >
                      {simbolo}
                    </text>
                  </g>
                ))}
                {/* tratti di nastro che continua */}
                <line x1={X0 - 26} y1={y + CELLA} x2={X0} y2={y + CELLA} stroke="var(--bordo-forte)" stroke-dasharray="3 4" />
                <line x1={X0 - 26} y1={y} x2={X0} y2={y} stroke="var(--bordo-forte)" stroke-dasharray="3 4" />
                <line x1={X0 + 5 * CELLA} y1={y + CELLA} x2={X0 + 5 * CELLA + 26} y2={y + CELLA} stroke="var(--bordo-forte)" stroke-dasharray="3 4" />
                <line x1={X0 + 5 * CELLA} y1={y} x2={X0 + 5 * CELLA + 26} y2={y} stroke="var(--bordo-forte)" stroke-dasharray="3 4" />
                {/* testina: triangolo sotto la cella letta + stato */}
                <path
                  d={`M ${X0 + f.testina * CELLA + CELLA / 2 - 8} ${y + CELLA + 16} L ${X0 + f.testina * CELLA + CELLA / 2 + 8} ${y + CELLA + 16} L ${X0 + f.testina * CELLA + CELLA / 2} ${y + CELLA + 4} Z`}
                  fill="var(--accento)"
                />
                <text
                  x={X0 + f.testina * CELLA + CELLA / 2}
                  y={y + CELLA + 30}
                  text-anchor="middle"
                  font-size="11.5"
                  font-weight="600"
                  fill="var(--accento)"
                >
                  {f.stato}
                </text>
                {/* didascalia a destra */}
                <foreignObject x={X0 + 5 * CELLA + 38} y={y - 4} width={LARGH - (X0 + 5 * CELLA + 46)} height={RIGA - 6}>
                  <p style="font-size: 12px; line-height: 1.45; color: var(--testo-tenue); margin: 0">{f.didascalia}</p>
                </foreignObject>
              </g>
            );
          })
        }
      </svg>
    </div>

    <section class="mt-8" aria-labelledby="alt-testuale">
      <h2 id="alt-testuale" class="font-serif text-xl">Alternativa testuale: i sei passi</h2>
      <ol class="mt-3 space-y-2 text-sm leading-relaxed max-w-2xl list-decimal ps-5">
        {
          FOTOGRAMMI.map((f) => (
            <li>
              Nastro: <span class="font-mono">{f.nastro.join(' ')}</span> · testina sulla cella{' '}
              {f.testina + 1} · stato <span class="font-mono">{f.stato}</span>. {f.didascalia}
            </li>
          ))
        }
      </ol>
    </section>

    <p class="mt-8 text-sm max-w-2xl leading-relaxed" style="color: var(--testo-tenue)">
      Il punto non è l’incremento: è che <em>qualunque</em> procedura effettiva — per la tesi di
      <a class="underline" href={withBase('/voce/tesi-di-church-turing')}>Church-Turing</a> — si
      riduce a una tabella come questa. E poiché la tabella è a sua volta un dato scrivibile su
      nastro, esiste la <em>macchina universale</em> che legge la tabella di un’altra macchina e la
      simula: il progetto concettuale del
      <a class="underline" href={withBase('/voce/programma-memorizzato')}>programma memorizzato</a>,
      e il fondamento dell’<a class="underline" href={withBase('/voce/indecidibilita')}>indecidibilità</a> —
      su questo modello Turing dimostrò che il
      <a class="underline" href={withBase('/voce/problema-della-fermata')}>problema della fermata</a> non
      ha soluzione.
    </p>
  </div>
</Base>
