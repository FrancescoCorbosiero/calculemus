---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/percorsi-url';

const DIAGRAMMI = [
  {
    slug: 'macchina-di-turing',
    titolo: 'La macchina di Turing',
    testo: 'Nastro, testina, tabella di stati: il modello minimo di calcolatore, con un esempio di esecuzione passo per passo.',
  },
  {
    slug: 'gerarchia-di-chomsky',
    titolo: 'La gerarchia di Chomsky',
    testo: 'Le quattro classi di grammatiche e i loro automi, come inclusioni concentriche con esempi per ciascun livello.',
  },
  {
    slug: 'scala-delle-astrazioni',
    titolo: 'La scala delle astrazioni',
    testo: 'Dal transistor alla porta logica, dall’ALU all’ISA, dal sistema operativo al linguaggio all’applicazione: ogni strato nasconde il precedente.',
  },
  {
    slug: 'mappa-della-complessita',
    titolo: 'La mappa della complessità',
    testo: 'P, NP, NP-completo, indecidibile: le classi come territori annidati, con i problemi celebri collocati sulla mappa.',
  },
];
---

<Base
  titolo="Diagrammi"
  descrizione="I diagrammi su misura dell'atlante: albero sefirotico, fasi dell'opera alchemica, tre mondi di Agrippa, ruota delle corrispondenze."
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="font-serif text-3xl">Diagrammi</h1>
    <p class="mt-2 max-w-2xl text-sm" style="color: var(--testo-tenue)">
      Quattro strutture che il grafo non può rendere: disegnate a mano nelle loro coordinate
      tradizionali, non generate da un layout automatico.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        DIAGRAMMI.map((diagramma) => (
          <a
            href={withBase(`/diagrammi/${diagramma.slug}`)}
            class="group rounded-lg border border-bordo bg-rialzato p-5 hover:border-bordo-forte"
          >
            <h2 class="font-serif text-xl text-accento group-hover:underline underline-offset-4">
              {diagramma.titolo} →
            </h2>
            <p class="mt-2 text-sm" style="color: var(--testo-tenue)">
              {diagramma.testo}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</Base>
